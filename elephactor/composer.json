{
  "name": "tim-lappe/elephactor",
  "version": "0.1.0",
  "description": "PHP Refactoring Tool",
  "autoload": {
    "psr-4": {
      "TimLappe\\Elephactor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TimLappe\\ElephactorTests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Tim Lappe",
      "email": "timlappe@proton.me"
    }
  ],
  "require": {
    "php": "^8.4",
    "nikic/php-parser": "^5.5",
    "symfony/console": "^8.0",
    "symfony/finder": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.20"
  },
  "scripts": {
    "test": [
      "@test:phpstan",
      "@test:phpunit"
    ],
    "test:phpstan": [
      "phpstan analyse"
    ],
    "test:phpunit": [
      "phpunit"
    ],
    "fix": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes"
  },
  "bin": [
    "bin/elephactor"
  ]
}
